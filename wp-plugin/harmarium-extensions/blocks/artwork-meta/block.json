{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "harmarium/artwork-meta",
  "version": "1.0.0",
  "title": "Artwork Meta",
  "category": "harmarium",
  "icon": "art",
  "description": "Displays extended metadata for a portfolio artwork (medium, dimensions, year, edition, availability).",
  "keywords": ["artwork", "meta", "portfolio"],
  "textdomain": "harmarium-ext",
  "usesContext": ["postId", "postType"],
  "supports": { "html": false, "align": ["wide"] },
  "attributes": {
    "showAvailability": { "type": "boolean", "default": true },
    "showCertificate":  { "type": "boolean", "default": false }
  },
  "render": "file:./render.php"
}
